# Copy this to .env and fill in your values
# ============================================================
# DJANGO SETTINGS
# ============================================================
DJANGO_SECRET_KEY=your-random-secret-key-here
DJANGO_DEBUG=True
# For production, set to False:
# DJANGO_DEBUG=False

ALLOWED_HOSTS=*
# For production, restrict to your server IP/hostname:
# ALLOWED_HOSTS=10.80.x.x,lms-dashboard.yourdomain.com,localhost

# ============================================================
# WAITRESS (production server) — only used by run_server.py
# ============================================================
HOST=0.0.0.0
PORT=8000
THREADS=8

# ============================================================
# SQL SERVER — LMS Data
# ============================================================
SQL_SERVER=your-server-hostname
SQL_DATABASE=LMS_Database
SQL_USERNAME=your-username
SQL_PASSWORD=your-password
SQL_DRIVER={ODBC Driver 17 for SQL Server}

# ============================================================
# SQL SERVER — Business Intelligence (Roster)
# ============================================================
BI_SERVER=your-bi-server-hostname
BI_DATABASE=Business_Intelligence
BI_USERNAME=your-username
BI_PASSWORD=your-password